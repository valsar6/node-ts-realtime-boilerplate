# Copy to .env and fill in real values. env.ts validates all of these at
# startup with Zod — the server refuses to boot if any are missing/invalid.

NODE_ENV=development
PORT=3000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated origins in production, e.g. https://app.example.com
CORS_ORIGIN=*

# error | warn | info | http | debug
LOG_LEVEL=info
